# AffinMail Admin REST API configuration (placeholder values only)
# Generate with: bash api/setup-env.sh
AFFINMAIL_ADMIN_TOKEN=change_me_64_hex_chars
VAULT_KEY=change_me_64_hex_chars

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=affinmail_user
DB_PASSWORD=change_me_db_password
DB_NAME=affinmail

STALWART_URL=http://127.0.0.1:8080
STALWART_ADMIN_USER=admin@affinmail.local
STALWART_ADMIN_PASSWORD=change_me_stalwart_admin_password

REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=

STORAGE_LOCAL_PATH=/var/www/affinmail/data/blobs
AUDIT_LOG=/var/www/affinmail/logs/admin-agent-audit.log
BACKUP_DIR=/var/www/affinmail/backups
