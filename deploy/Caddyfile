# AffinMail Production Caddyfile
# Multi-Domain Reverse Proxy, Automated TLS 1.3, HTTP/3, and SPA Hosting

{$MAIL_HOSTNAME:mail.hostaffin.com} {
    # 1. AffinMail Webmail Frontend (React 19 + DaisyUI SPA)
    root * /var/www/affinmail-web/dist
    file_server
    try_files {path} /index.html

    # Gzip and Zstandard Compression for Webmail Assets
    encode zstd gzip

    # 2. JMAP Protocol Endpoint (RFC 8620 / RFC 8621)
    handle /jmap* {
        reverse_proxy stalwart:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # 3. Real-Time WebSocket Gateway
    handle /ws* {
        reverse_proxy stalwart:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up Upgrade {http.upgrade}
            header_up Connection "Upgrade"
        }
    }

    # 4. Hostaffin Admin & Management REST API
    handle /api/* {
        reverse_proxy stalwart:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # 5. Security & Deliverability Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' wss://* https://*;"
    }
}
