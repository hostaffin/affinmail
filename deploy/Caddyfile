# AffinMail Production Caddyfile
# Port 2087: WHM-Equivalent Admin Control Panel (Standalone Management)
# Port 2083 & 443: Client Gmail-Grade Webmail Client
# Protocol Support: HTTP/3 (QUIC), Automated TLS 1.3, JMAP, WebSocket

# ==============================================================================
# 1. AffinMail Admin Control Panel (WHM Equivalent) - Port 2087
# ==============================================================================
:2087, {$MAIL_HOSTNAME:mail.hostaffin.com}:2087 {
    root * /var/www/affinmail-web/dist
    file_server
    try_files {path} /index.html

    encode zstd gzip

    # Admin Management REST API
    handle /api/* {
        reverse_proxy stalwart:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Security Headers for Admin Panel
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# ==============================================================================
# 2. AffinMail Client Webmail - Port 2083 & Port 443 / 80
# ==============================================================================
:2083, {$MAIL_HOSTNAME:mail.hostaffin.com}:2083, {$MAIL_HOSTNAME:mail.hostaffin.com} {
    root * /var/www/affinmail-web/dist
    file_server
    try_files {path} /index.html

    encode zstd gzip

    # JMAP Protocol Endpoint (RFC 8620 / RFC 8621)
    handle /jmap* {
        reverse_proxy stalwart:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Real-Time WebSocket Gateway
    handle /ws* {
        reverse_proxy stalwart:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up Upgrade {http.upgrade}
            header_up Connection "Upgrade"
        }
    }

    # Internal API
    handle /api/* {
        reverse_proxy stalwart:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' wss://* https://*;"
    }
}
