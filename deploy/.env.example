# AffinMail Native Production Environment Variables (Zero-Docker Native Bare Metal)

# Host & Network Configuration
MAIL_HOSTNAME=mail.hostaffin.com
SHARED_OUTBOUND_IPV4=195.201.10.101

# Native PostgreSQL 16 Credentials (Runs on 127.0.0.1:5432)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=affinmail_user
POSTGRES_PASSWORD=ChangeMeSecureDbPassword2026!
POSTGRES_DB=affinmail

# Native Redis 7 Configuration (Runs on 127.0.0.1:6379)
STALWART_REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=

# Stalwart Administrative REST API Secret (Shared with Hostaffin WHMCS driver)
STALWART_ADMIN_SECRET=aff_live_sec_90812489123847120938401923

# Pluggable Dynamic Storage Backend: fs | s3 | sftp
STORAGE_BLOB_TYPE=fs
STORAGE_LOCAL_PATH=/opt/affinmail/data/blobs
WEBMAIL_ROOT=/opt/affinmail/webmail/dist

# S3 Object Storage Configuration (When STORAGE_BLOB_TYPE=s3)
S3_BUCKET=affinmail-blobs
S3_REGION=auto
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key

# SFTP / Remote Storage Box Configuration (When STORAGE_BLOB_TYPE=sftp)
SFTP_HOST=uXXXXXX.your-storagebox.de
SFTP_USER=uXXXXXX
SFTP_PORT=23
SFTP_REMOTE_PATH=/home/affinmail-blobs
