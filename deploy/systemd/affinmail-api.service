[Unit]
Description=AffinMail Admin REST API (Native Rust Server)
Documentation=https://github.com/hostaffin/affinmail
After=network.target postgresql.service redis.service stalwart.service
Wants=network.target

[Service]
User=root
WorkingDirectory=/opt/affinmail
Environment=PORT=8090
Environment=RUST_LOG=info
ExecStart=/opt/affinmail/target/release/affinmail-server
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
