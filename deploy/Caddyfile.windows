# AffinMail Windows Local Test Caddyfile
{
	admin off
	auto_https off
}

# 1. Cluster Admin Panel (Port 2087 - API Automatable)
:2087 {
	root * webmail/dist
	file_server
	try_files {path} /index.html
	encode gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}
}

# 2. Client User Panel / Webmail (Port 2083 - MCP Automatable)
:2083 {
	root * webmail/dist
	file_server
	try_files {path} /index.html
	encode gzip

	handle /jmap* {
		reverse_proxy 127.0.0.1:8080
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}
}
